---
import hours from '../data/hours.json';
const lines = hours.display.filter((h) => h.time !== 'Closed');
---

<svg class="hours-starburst-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <polygon
    points="100.0,1.2 113.8,39.6 141.2,14.4 140.2,49.6 174.3,40.8 154.2,73.9 196.3,78.0 162.0,100.0 192.6,121.1 158.1,128.0 172.0,157.5 138.7,148.5 142.9,189.0 113.8,160.4 100.0,195.0 85.7,162.9 58.8,185.6 61.3,148.5 22.8,161.6 44.1,126.9 10.2,120.5 35.5,100.0 7.4,78.9 44.1,73.1 22.8,38.4 62.5,53.0 58.8,14.4 85.7,37.1"
    fill="var(--sage-600)"
  />
  <text x="100" y="93" text-anchor="middle" class="hours-starburst-line">{lines[0]?.days}</text>
  <text x="100" y="109" text-anchor="middle" class="hours-starburst-line">{lines[0]?.time}</text>
  <text x="100" y="128" text-anchor="middle" class="hours-starburst-line">{lines[1]?.days}</text>
  <text x="100" y="144" text-anchor="middle" class="hours-starburst-line">{lines[1]?.time}</text>
</svg>

<style>
  .hours-starburst-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hours-starburst-line {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    fill: var(--cream-50);
  }
</style>
