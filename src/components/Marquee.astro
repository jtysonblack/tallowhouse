---
const phrases = [
  'Pure Smashburgers — The Way It Should Be',
  'Join The Family',
  'The Best Burger Ever',
];
const repeated = Array.from({ length: 4 }).flatMap(() => phrases);
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {repeated.map((phrase) => (
      <span class="marquee-item">
        {phrase}
        <img src="/images/marquee-burger.webp" alt="" class="marquee-burger" />
      </span>
    ))}
  </div>
</div>

<style>
  .marquee {
    position: relative;
    z-index: 2;
    width: 100%;
    overflow: hidden;
    background: var(--char-950);
    border-top: var(--border-thin) solid var(--char-700);
    padding-block: var(--space-3);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 40s linear infinite;
  }

  .marquee-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    padding-inline: var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--cream-200);
    white-space: nowrap;
  }
  .marquee-burger {
    height: 32px;
    width: auto;
    flex-shrink: 0;
    display: block;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-25%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>
