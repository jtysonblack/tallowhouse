---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Grain from '../components/Grain.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  showFooter?: boolean;
}

const {
  title,
  description,
  image = '/images/hero-storefront-night.jpg',
  showFooter = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-93GK3NKJK6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-93GK3NKJK6');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo-mascot.png" />
    <link rel="canonical" href={canonicalURL} />
    <ViewTransitions />

    <title>{title} | Tallow House</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Tallow House`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Tallow House" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Tallow House`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="theme-color" content="#264A38" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Grain />
    <div class="page-flash" id="page-flash"></div>
    <Header />
    <main id="main" transition:animate="fade">
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>

<style>
  .page-flash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--sage-600);
    pointer-events: none;
    opacity: 0;
  }
  .page-flash.is-active {
    animation: page-flash-wipe 0.5s var(--ease-default, ease) forwards;
  }
  @keyframes page-flash-wipe {
    0%   { opacity: 0; }
    35%  { opacity: 1; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-flash.is-active { animation: none; }
  }
</style>

<script>
  document.addEventListener('astro:before-swap', () => {
    const flash = document.getElementById('page-flash');
    if (!flash) return;
    flash.classList.remove('is-active');
    // eslint-disable-next-line no-void
    void flash.offsetWidth;
    flash.classList.add('is-active');
  });

  // The gtag.js base snippet only fires its automatic pageview once, on
  // hard load. Astro's <ViewTransitions /> router swaps pages client-side
  // without a reload, so every in-app navigation needs its own manual
  // pageview sent — astro:after-swap fires on those transitions only
  // (not on the initial load, which the base snippet already tracked).
  document.addEventListener('astro:after-swap', () => {
    if (typeof gtag === 'function') {
      gtag('event', 'page_view', {
        page_location: location.href,
        page_path: location.pathname,
        page_title: document.title,
      });
    }
  });
</script>
