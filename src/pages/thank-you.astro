---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
---

<Layout title="Thank You" description="Thanks for reaching out to Tallow House.">
  <section class="section thank-you section-dark">
    <div class="container thank-you-inner">
      <img src="/images/logo-mascot.png" alt="Tallow House" width="96" height="96" />
      <h1 class="h1">Got It.</h1>
      <p class="body-lg">
        Thanks for reaching out — we'll be in touch. In the meantime, follow along
        for drops, events, and hour changes.
      </p>
      <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        Instagram {site.social.instagramHandle} →
      </a>
      <a href="/" class="btn btn-secondary">Back Home</a>
    </div>
  </section>
</Layout>

<style>
  .thank-you { min-height: 60vh; display: flex; align-items: center; }
  .thank-you-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }
  .thank-you-inner img { border-radius: 50%; margin-bottom: var(--space-2); }
  .thank-you-inner .body-lg { max-width: 50ch; color: var(--cream-300); margin-bottom: var(--space-4); }
</style>
