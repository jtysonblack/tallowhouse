---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import hours from '../data/hours.json';
---

<Layout
  title="Join The Family"
  description="Join the Tallow House team — now hiring for all positions. Or get in touch: location, hours, and a contact form. No phone, no email listed."
>
  <section class="section join-hero section-dark">
    <div class="container join-hero-grid">
      <div>
        <p class="script join-hero-script">Come be part of this.</p>
        <h1 class="join-headline">Join The Team</h1>
        <p class="join-subheadline">Now Hiring</p>
        <ul class="join-reqs">
          <li>Must be comfortable with high kitchen volume</li>
          <li>Very competitive pay</li>
        </ul>

        <form
          name="job-application"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/thank-you"
          class="mac-form app-form"
        >
          <input type="hidden" name="form-name" value="job-application" />
          <p class="hidden-field">
            <label>Don't fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <label for="name" class="visually-hidden">Full Name</label>
          <input type="text" id="name" name="name" placeholder="Full Name" required />

          <label for="phone" class="visually-hidden">Phone Number</label>
          <input type="tel" id="phone" name="phone" placeholder="Phone Number" required />

          <label for="email" class="visually-hidden">Email Address</label>
          <input type="email" id="email" name="email" placeholder="Email Address" required />

          <label for="age-eligible" class="app-form-question-label">
            Are you 16 years or older and legally eligible to work in the US?
          </label>
          <select id="age-eligible" name="age_eligible" required>
            <option value="">Select one</option>
            <option>Yes</option>
            <option>No</option>
          </select>

          <label for="hours-desired" class="app-form-question-label">
            How many hours are you looking to work per week?
          </label>
          <select id="hours-desired" name="hours_desired" required>
            <option value="">Select one</option>
            <option>Part-time</option>
            <option>Full-time</option>
          </select>

          <label for="availability" class="app-form-question-label">
            What days and shifts are you available, and when can you start?
          </label>
          <input type="text" id="availability" name="availability" required />

          <label for="food-service-experience" class="app-form-question-label">
            Tell us about your previous work experience, specifically in food service or customer service.
          </label>
          <textarea id="food-service-experience" name="food_service_experience" rows="4" required></textarea>

          <label for="high-pressure-experience" class="app-form-question-label">
            Describe a time you had to handle a high pressure situation or a very busy rush at work.
          </label>
          <textarea id="high-pressure-experience" name="high_pressure_experience" rows="4" required></textarea>

          <label for="food-safety-cert" class="app-form-question-label">
            Do you have any current food safety certifications (e.g., ServSafe)?
          </label>
          <select id="food-safety-cert" name="food_safety_cert" required>
            <option value="">Select one</option>
            <option>Yes</option>
            <option>No</option>
          </select>

          <label for="why-tallow-house" class="app-form-question-label">
            Why do you want to work at Tallow House?
          </label>
          <textarea id="why-tallow-house" name="why_tallow_house" rows="4" required></textarea>

          <label for="team-player" class="app-form-question-label">
            Our team works closely together in a fast paced environment. What makes you a great team player?
          </label>
          <textarea id="team-player" name="team_player" rows="4" required></textarea>

          <button type="submit" class="mac-submit">
            Submit Application
            <svg class="mac-submit-arrow" viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M42 2 L78 30 L42 58" stroke="currentColor" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M0 30 H74" stroke="currentColor" stroke-width="9" stroke-linecap="round" />
            </svg>
          </button>
        </form>
      </div>
      <div class="join-photo-strip">
        <img src="/images/careers-team-plating.jpg" alt="Team plating burgers behind the counter" loading="lazy" />
        <img src="/images/careers-grill-action.jpg" alt="Raw smash patties on the flat top with fryer baskets" loading="lazy" />
        <img src="/images/careers-cook-portrait.jpg" alt="Cook in a Tallow House cap at the flat top grill" loading="lazy" />
        <img src="/images/careers-line-outside.jpg" alt="Customers lined up outside the Tallow House storefront" loading="lazy" />
        <img src="/images/careers-order-pass.jpg" alt="Cook at the order pass with bagged orders ready for pickup" loading="lazy" />
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <section class="section contact-grid-section">
    <div class="container">
      <h2 class="h2">Contact Us</h2>
      <p class="body-lg contact-desc">
        Send a message here, email us directly, or find us
        on Instagram where the real-time updates live.
      </p>

      <div class="contact-grid">
        <div class="contact-info">
          <div class="info-block">
            <h3 class="h3">Email</h3>
            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>

          <div class="info-block">
            <h3 class="h3">Location</h3>
            <p>{site.location.line1}<br />{site.location.line2}</p>
            <a
              href={`https://maps.google.com/?q=${encodeURIComponent(site.location.mapQuery)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary"
              style="margin-top: var(--space-4);"
            >Get Directions →</a>
          </div>

          <div class="info-block">
            <h3 class="h3">Hours</h3>
            <ul class="hours-list">
              {hours.display.map((h) => (
                <li><span>{h.days}</span><span>{h.time}</span></li>
              ))}
            </ul>
            {hours.exceptions.map((ex) => (
              <p class="hours-exception"><strong>{ex.label}:</strong> {ex.detail}</p>
            ))}
          </div>

          <div class="map-embed">
            <iframe
              title="Map to Tallow House"
              src={`https://maps.google.com/maps?q=${encodeURIComponent(site.location.mapQuery)}&z=15&output=embed`}
              width="100%"
              height="280"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

        <div class="contact-form-wrap">
          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/thank-you"
            class="contact-form"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden-field">
              <label>Don't fill this out if you're human: <input name="bot-field" /></label>
            </p>

            <div class="form-row">
              <label for="c-name">Name</label>
              <input type="text" id="c-name" name="name" required />
            </div>

            <div class="form-row">
              <label for="c-email">Email</label>
              <input type="email" id="c-email" name="email" required />
            </div>

            <div class="form-row">
              <label for="c-message">Message</label>
              <textarea id="c-message" name="message" rows="6" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .join-hero-grid { display: grid; gap: var(--space-10); align-items: start; }
  .join-hero-script { font-size: var(--text-2xl); color: var(--sage-300); margin-bottom: var(--space-2); }
  .join-headline {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 6rem);
    color: var(--amber-400);
    line-height: 0.95;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .join-subheadline {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--sage-300);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-top: var(--space-2);
  }
  .join-reqs {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .join-reqs li {
    color: var(--cream-200);
    font-size: var(--text-md);
    padding-left: var(--space-4);
    position: relative;
  }
  .join-reqs li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--sage-400);
  }

  .join-photo-strip {
    display: grid;
    gap: var(--space-3);
    border: var(--border-medium) solid var(--sage-600);
    padding: var(--space-3);
  }
  .join-photo-strip img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }

  .app-form { margin-top: var(--space-8); }
  .app-form .mac-submit {
    font-size: clamp(1.5rem, 4vw, 3rem);
    width: auto;
    justify-self: center;
  }
  .app-form-question-label {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    letter-spacing: var(--tracking-wide);
    font-size: clamp(1.05rem, 2.1vw, 1.35rem);
    line-height: 1.2;
    color: var(--cream-100);
    margin-top: var(--space-2);
    margin-bottom: -0.25rem;
  }

  .hidden-field { position: absolute; left: -9999px; }
  .form-row { display: flex; flex-direction: column; gap: var(--space-2); }
  .form-row label {
    font-family: var(--font-display);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .form-row input,
  .form-row select,
  .form-row textarea {
    border: var(--border-thin) solid var(--border-default);
    background: var(--bg-surface);
    color: var(--text-primary);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
  }
  .form-row input:focus,
  .form-row select:focus,
  .form-row textarea:focus { border-color: var(--focus-ring); }
  .contact-form .btn { align-self: flex-start; margin-top: var(--space-2); }

  .section-divider {
    border: none;
    border-top: var(--border-thin) solid var(--border-default);
    margin: 0 var(--section-x);
  }

  .contact-desc { max-width: 60ch; margin-top: var(--space-4); color: var(--text-secondary); }

  .contact-grid { display: grid; gap: var(--space-12); margin-top: var(--space-10); }
  .contact-info { display: flex; flex-direction: column; gap: var(--space-8); }
  .info-block p { color: var(--text-secondary); margin-top: var(--space-2); }
  .info-block .h3 { margin-bottom: var(--space-1); }
  .info-block a:hover { color: var(--sage-400); text-decoration: underline; }

  .hours-list { margin-top: var(--space-2); display: flex; flex-direction: column; gap: var(--space-1); }
  .hours-list li {
    display: flex;
    justify-content: space-between;
    max-width: 26rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-1);
    color: var(--text-secondary);
  }
  .hours-exception { margin-top: var(--space-3); font-size: var(--text-sm); }

  .map-embed {
    border: var(--border-thin) solid var(--border-default);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .contact-form { display: flex; flex-direction: column; gap: var(--space-5); }

  @media (min-width: 800px) {
    .join-hero-grid { grid-template-columns: 1.2fr 1fr; }
  }
  @media (min-width: 900px) {
    .contact-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
