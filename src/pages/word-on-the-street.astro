---
import Layout from '../layouts/Layout.astro';

const newsVideos = [
  { type: 'youtube', id: 'iqoFUIJD61E', caption: 'Tallow House is making its mark as locals line up for burgers' },
  { type: 'youtube', id: 'T_YfmjQ59ME', caption: '3 In Your Town: Tallow House burgers go viral in Cleveland, TN' },
];

const influencerVideos = [
  { type: 'instagram', url: 'https://www.instagram.com/reel/DYiVA0eyEcv/', thumb: '/images/wots-ig-webbchatts.webp', caption: '@webbchatts' },
  { type: 'instagram', url: 'https://www.instagram.com/reel/DY0SiB6PnR7/', thumb: '/images/wots-ig-dadbodcooking.webp', caption: '@dadbod.cooking' },
  { type: 'instagram', url: 'https://www.instagram.com/reel/DZ5OhDllBnH/', thumb: '/images/wots-ig-local3news.webp', caption: '@local3news — "The Viral Burger"' },
];

const ratings = [
  { source: 'Google', rating: '4.8', count: '241 reviews' },
  { source: 'Facebook', rating: '4.6', count: '33 reviews' },
];

const reviews = [
  { source: 'Google', quote: "And you can't go wrong with tallow cooked fries, and homemade spicy ketchup.", author: 'Google review' },
  { source: 'Google', quote: 'Great bun, fresh beef, the secret sauce is what makes it.', author: 'Google review' },
  { source: 'Google', quote: 'They genuinely care about their service and quality of food.', author: 'Google review' },
  { source: 'Facebook', quote: 'Best burger I have had in a long time! The plus was cooked in Beef Tallow!', author: 'Michelle Harrison McAfee' },
  { source: 'Facebook', quote: 'TALLOW HOUSE is the truth!!! That\'s my review.', author: 'Extraordinaire' },
  { source: 'Google', quote: 'Meat and cheese and a little bit of grilled onions.', author: 'Google review' },
];
---

<Layout
  title="Word On The Street"
  description="What people are saying about Tallow House — local news coverage, influencer reviews, and Google and Facebook reviews."
>
  <section class="section wots-hero section-dark">
    <div class="container">
      <h1 class="h1">Word On The Street</h1>
      <p class="body-lg wots-hero-desc">
        We don't have to tell you it's the best burger in town — plenty of people already have.
        Here's what local news, reviewers, and regulars are saying.
      </p>
    </div>
  </section>

  <section class="section wots-videos-section">
    <div class="container">
      <h2 class="h2">Reviewer Videos</h2>
      <div class="wots-video-grid wots-video-grid--reviewers">
        {influencerVideos.map((v) => (
          <div class="wots-video-card">
            <a href={v.url} target="_blank" rel="noopener noreferrer" class="wots-ig-card">
              <img src={v.thumb} alt={v.caption} loading="lazy" />
              <span class="wots-ig-badge">Instagram</span>
            </a>
            <p>{v.caption}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark wots-press-section">
    <div class="container">
      <h2 class="h2">In The News</h2>
      <div class="wots-video-grid">
        {newsVideos.map((v) => (
          <div class="wots-video-card">
            <div class="wots-video-slot wots-video-slot--wide">
              <iframe
                src={`https://www.youtube.com/embed/${v.id}`}
                title={v.caption}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
            <p>{v.caption}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wots-reviews-section">
    <div class="container">
      <h2 class="h2">From The Reviews</h2>
      <div class="wots-rating-row">
        {ratings.map((r) => (
          <div class="wots-rating-badge">
            <span class="wots-rating-source">{r.source}</span>
            <span class="wots-rating-score">{r.rating} <span class="wots-rating-star">★</span></span>
            <span class="wots-rating-count">{r.count}</span>
          </div>
        ))}
      </div>
      <div class="wots-review-grid">
        {reviews.map((r) => (
          <div class="wots-review-card">
            <span class="wots-review-source">{r.source}</span>
            <p class="wots-review-quote">"{r.quote}"</p>
            <p class="wots-review-author">— {r.author}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .wots-hero-desc { max-width: 60ch; margin-top: var(--space-4); color: var(--cream-400); }

  .wots-video-grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-10);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .wots-video-grid--reviewers {
    grid-template-columns: repeat(auto-fit, minmax(220px, 300px));
  }
  .wots-video-slot {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--char-950);
    margin-bottom: var(--space-4);
  }
  .wots-video-slot--wide {
    aspect-ratio: 16/9;
  }
  .wots-video-slot iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .wots-ig-card {
    position: relative;
    display: block;
    aspect-ratio: 9/16;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-4);
    background: var(--char-950);
    transition: var(--transition-transform);
  }
  .wots-ig-card:hover { transform: scale(1.015); }
  .wots-ig-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wots-ig-badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background: rgba(7, 6, 5, 0.65);
    backdrop-filter: blur(4px);
    color: var(--cream-50);
    font-family: var(--font-display);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: var(--text-xs);
    padding: 4px var(--space-3);
    border-radius: var(--radius-full);
  }

  .wots-video-card p { color: var(--text-secondary); margin-top: var(--space-1); font-size: var(--text-sm); }
  .wots-press-section .wots-video-card p { color: var(--cream-400); }

  .wots-rating-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }
  .wots-rating-badge {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-4) var(--space-6);
    border: var(--border-thin) solid var(--border-default);
    border-radius: var(--radius-lg);
  }
  .wots-rating-source {
    font-family: var(--font-display);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .wots-rating-score {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--text-primary);
  }
  .wots-rating-star { color: var(--amber-500); }
  .wots-rating-count { font-size: var(--text-sm); color: var(--text-muted); }

  .wots-review-grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-10);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .wots-review-card {
    border: var(--border-thin) solid var(--border-default);
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .wots-review-source {
    font-family: var(--font-display);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: var(--text-sm);
    color: var(--text-brand);
  }
  .wots-review-quote { margin-top: var(--space-3); color: var(--text-primary); }
  .wots-review-author { margin-top: var(--space-3); color: var(--text-muted); font-size: var(--text-sm); }
</style>
